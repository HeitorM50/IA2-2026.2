# --- LaTeX ---
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.run.xml
*.bcf
*.lof
*.lot
*.spl
main.pdf
artigo-*/paper/*.pdf

# --- Python / experimentos ---
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.pt
*.pth
*.ckpt
runs/
wandb/
mlruns/

# --- dados brutos (baixe com script, não versione) ---
artigo-*/src/data/
*.csv
*.parquet
*.npz

# --- SO / editor ---
.DS_Store
*.swp

# --- Claude Code (local, não versionado) ---
.claude/

# --- arquivos de transporte (resultados ja versionados em src/results/) ---
*.zip

# --- notas pessoais, fora do versionamento ---
artigo-*/EXPLICACAO-*.md

# --- resultados dos experimentos ---
# São pequenos e alimentam a tabela do artigo, então abrem exceção ao *.csv acima.
!artigo-*/src/results/
!artigo-*/src/results/*.csv
!artigo-*/src/results/*.json

# --- corpus do Artigo 3: PDFs e texto extraído não são versionados (#46, #48) ---
# O manifesto só tem hashes e contagens, então pode ser versionado.
artigo-*/data/*
!artigo-*/data/README.md
!artigo-*/data/manifesto-corpus.json

# --- resultados brutos do Artigo 3 ---
# Os JSON por pergunta carregam o texto dos slides recuperado; ficam fora do Git
# até a decisão de redistribuição (#46). O run.log precisa escapar do *.log acima.
artigo-*/src/results/raw/**/*.json
!artigo-*/src/results/raw/**/run-manifest.json
!artigo-*/src/results/raw/**/environment.json
!artigo-*/src/results/**/run.log
